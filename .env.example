# Copy to .env and fill in. Never commit .env.
# Empty values are ignored (they don't override config.yaml).

# --- Chains: tron (default), ton, eth — comma-separated, e.g. tron,ton,eth ---
# CHAINS=tron

# --- Ethereum (ERC-20 USDT via JSON-RPC, read-only) ---
# Secret if it embeds a provider key (Infura/Alchemy/...). Default: free public node
# https://ethereum-rpc.publicnode.com (rate limited, recent blocks only).
ETH_RPC_URL=
# ETH_RPS=5
# Comma-separated Ethereum addresses (0x..., lowercase or EIP-55).
ETH_WATCH_ADDRESSES=
# ETH_CONFIRMATIONS=12
# ETH_START_BLOCK=0
# ETH_POLL_INTERVAL=6s
# ETH_BATCH_SIZE=50
# ETH_LOG_CHUNK=50
# latest (default, minus ETH_CONFIRMATIONS) | safe | finalized (reorg-proof; set ETH_CONFIRMATIONS=0)
# ETH_HEAD_TAG=latest
# ETH_CURSOR_FILE=./data/cursor-eth.json

# --- TON (toncenter v3, read-only) ---
# TON_API_URL=https://toncenter.com/api/v3
# Strongly recommended for TON: free key from @tonapibot (Telegram); then TON_RPS=9.
TONCENTER_API_KEY=
# TON_RPS=1
# TON_JETTON_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
# Comma-separated TON addresses (EQ…/UQ… or 0:<hex>).
TON_WATCH_ADDRESSES=
# TON_CONFIRMATIONS=3
# TON_START_BLOCK=0
# TON_POLL_INTERVAL=1s
# TON_CURSOR_FILE=./data/cursor-ton.json

# --- TRON API ---
TRON_API_URL=https://api.trongrid.io
# Optional: free key from https://www.trongrid.io/ raises rate limits.
TRON_PRO_API_KEY=
# TRON_RPS=3

# --- Listener ---
# LISTENER_CONFIRMATIONS=20
# LISTENER_START_BLOCK=0
LOG_LEVEL=info
LOG_FORMAT=json

# --- Filter ---
# Comma-separated base58 (T...) or hex (41...) addresses.
FILTER_WATCH_ADDRESSES=
# FILTER_DIRECTION=both
# Large-transfer threshold in USDT (e.g. 100000). Empty/0 = disabled.
FILTER_MIN_AMOUNT=
# FILTER_MODE=any
# How often runtime watch_addresses rows are re-read from Postgres (API writes apply immediately).
# FILTER_RELOAD_INTERVAL=5s

# --- Admin API (GET/POST/DELETE /v1/addresses on HTTP_ADDR, default :9090) ---
# Bearer token, min 16 chars, e.g. `openssl rand -hex 32`. Empty = API disabled.
# Requires the Postgres sink (SINK_POSTGRES_ENABLED=true); otherwise the API returns 503.
API_TOKEN=
# The same token protects GET /v1/export.csv (CSV statement per address, needs the postgres sink).

# --- Sinks ---
SINK_STDOUT_ENABLED=true

SINK_WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_SECRET=

SINK_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_MIN_AMOUNT=

# --- Self-service notify bot (/add <address> → DM per transfer; needs SINK_POSTGRES_ENABLED=true) ---
NOTIFY_BOT_ENABLED=false
TELEGRAM_NOTIFY_BOT_TOKEN=
# NOTIFY_FREE_LIMIT=3
# NOTIFY_PREMIUM_LIMIT=50
# NOTIFY_MIN_AMOUNT=0.01

# --- Large-transfer channel (any chain, independent of the watch list) ---
LARGE_ALERTS_ENABLED=false
# Defaults to TELEGRAM_BOT_TOKEN when empty. The bot must be an admin of the channel.
LARGE_ALERTS_BOT_TOKEN=
LARGE_ALERTS_CHAT_ID=
# LARGE_ALERTS_THRESHOLD=100000
# LARGE_ALERTS_INTERVAL=3s
# LARGE_ALERTS_FOOTER=

SINK_POSTGRES_ENABLED=false
# Used by docker-compose (password is for the local dev container only).
POSTGRES_PASSWORD=listener
DATABASE_URL=
